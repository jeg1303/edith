

# Required: free key from https://console.groq.com  (starts with gsk_)
GROQ_API_KEY=

LLM_PROVIDER=groq

# Only needed if LLM_PROVIDER=gemini: free key from https://aistudio.google.com (starts with AIza)
GEMINI_API_KEY=

# Voice Recognition (Speech-to-Text) Provider: groq or gnani
STT_PROVIDER=groq

# Required if STT_PROVIDER=gnani: key from https://vachana.ai (Gnani dashboard)
GNANI_API_KEY=

# Gnani.ai STT settings (see https://docs.gnani.ai)
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=en-IN,ta-IN
GNANI_STT_FORMAT=transcribe

# Voices (run `edge-tts --list-voices` to see all)
VOICE_EN=en-GB-SoniaNeural
VOICE_TA=ta-IN-PallaviNeural

# Personalise
ASSISTANT_NAME=EDITH
USER_NAME=Gyan
SCHEDULE=
